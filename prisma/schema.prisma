// Prisma schema — Fase 1 MVP rebuild (lihat PRD.md §5.1)
// RBAC: users / divisions / roles / permissions / role_permissions / user_roles
// Auth ditangani Supabase (auth.users) — users adalah profil public yang
// mereferensikan auth.users(id). RLS diaktifkan via SQL di migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["accounting"]
}

/// Profil user; id mengikuti auth.users (Supabase Auth).
model User {
  id         String     @id @db.Uuid
  email      String     @unique
  name       String?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  divisionId String?    @map("division_id") @db.Uuid
  division   Division?  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  roles      UserRole[]
  transactions Transaction[] @relation("TransactionCreator")
  approvals  Approval[]
  invoices   Invoice[]     @relation("InvoiceCreator")
  forecasts  Forecast[]    @relation("ForecastCreator")
  importBatches ImportBatch[] @relation("ImportCreator")
  schedules  Schedule[]    @relation("ScheduleCreator")

  @@schema("accounting")
  @@map("users")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  roles     Role[]
  costCenters CostCenter[]

  @@schema("accounting")
  @@map("divisions")
}

/// Level role: staff/kepala/direktur/admin/superadmin (union di src/types/rbac.ts).
model Role {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  level      String
  divisionId String?  @map("division_id") @db.Uuid
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")
  users      UserRole[]
  permissions RolePermission[]

  @@schema("accounting")
  @@map("roles")
}

/// Action: create/read/update/delete/approve/print (union di src/types/rbac.ts).
model Permission {
  id     String @id @default(uuid()) @db.Uuid
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
  @@schema("accounting")
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("accounting")
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@schema("accounting")
  @@map("user_roles")
}

// ============================================================================
// Master data (PRD §5.2)
// ============================================================================

/// Chart of accounts hierarkis. type: asset/liability/equity/revenue/expense
/// (union di src/types/master-data.ts). parent dihapus => ditolak jika punya child.
model ChartOfAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      String
  name      String
  type      String
  parentId  String?           @map("parent_id") @db.Uuid
  parent    ChartOfAccount?   @relation("CoaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  ChartOfAccount[]  @relation("CoaHierarchy")
  journalEntries JournalEntry[]
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([code])
  @@index([parentId])
  @@schema("accounting")
  @@map("chart_of_accounts")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  invoices    Invoice[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@schema("accounting")
  @@map("customers")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  invoices    Invoice[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@schema("accounting")
  @@map("suppliers")
}

model CostCenter {
  id         String   @id @default(uuid()) @db.Uuid
  code       String
  name       String
  divisionId String?  @map("division_id") @db.Uuid
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")
  transactions Transaction[]

  @@unique([code])
  @@schema("accounting")
  @@map("cost_centers")
}

// ============================================================================
// Transaksi & Buku Besar (PRD §5.3–5.4)
// ============================================================================

model AccountingPeriod {
  id        String   @id @default(uuid()) @db.Uuid
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("open") // open | closed
  closedBy  String?  @map("closed_by") @db.Uuid
  closedAt  DateTime? @map("closed_at")
  createdAt DateTime @default(now()) @map("created_at")
  transactions Transaction[]

  @@index([status])
  @@schema("accounting")
  @@map("accounting_periods")
}

/// Multi-currency: amount = mata uang asli, base_amount = konversi ke IDR
/// dengan rate_snapshot saat transaksi dibuat (laporan historis konsisten).
model Transaction {
  id        String   @id @default(uuid()) @db.Uuid
  type      String // income | expense (Fase 1)
  date      DateTime
  description String
  amount    Decimal // mata uang asli
  currency  String
  baseAmount Decimal @map("base_amount")
  rateSnapshot Decimal @map("rate_snapshot")
  costCenterId String? @map("cost_center_id") @db.Uuid
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdBy String @map("created_by") @db.Uuid
  createdByUser User? @relation("TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  status    String   @default("pending") // draft | pending | approved | rejected
  accountingPeriodId String? @map("accounting_period_id") @db.Uuid
  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  source    String   @default("manual")
  createdAt DateTime @default(now()) @map("created_at")
  journalEntries JournalEntry[]
  approvals  Approval[]

  @@index([date, status])
  @@index([accountingPeriodId])
  @@index([createdBy])
  @@index([costCenterId])
  @@index([currency])
  @@schema("accounting")
  @@map("transactions")
}

model JournalEntry {
  id          String   @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId   String   @map("account_id") @db.Uuid
  account     ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit       Decimal  @default(0)
  credit      Decimal  @default(0)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([transactionId])
  @@schema("accounting")
  @@map("journal_entries")
}

/// Workflow approval penuh di Fase 2; tabel dibuat di Fase 1.
/// level: 1 = kepala, 2 = direktur. status: approved | rejected.
model Approval {
  id          String   @id @default(uuid()) @db.Uuid
  transactionId String @map("transaction_id") @db.Uuid
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approverId  String   @map("approver_id") @db.Uuid
  approver    User     @relation(fields: [approverId], references: [id], onDelete: Restrict)
  level       Int
  status      String
  note        String?
  approvedAt  DateTime @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([approverId])
  @@schema("accounting")
  @@map("approvals")
}

/// Invoice untuk modul Receivable & Payable — melacak tagihan piutang (dari
/// pelanggan) dan hutang (ke pemasok). status: draft, sent, paid, overdue,
/// cancelled. type: receivable (piutang) | payable (hutang).
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   // receivable | payable
  number      String   @unique // nomor invoice unik
  customerId  String?  @map("customer_id") @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  String?  @map("supplier_id") @db.Uuid
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal  // jumlah tagihan
  currency    String   @default("IDR")
  status      String   @default("draft") // draft | sent | paid | overdue | cancelled
  dueDate     DateTime @map("due_date")
  paidAt      DateTime? @map("paid_at")
  createdBy   String   @map("created_by") @db.Uuid
  createdByUser User?  @relation("InvoiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type, status])
  @@index([customerId])
  @@index([supplierId])
  @@index([dueDate])
  @@schema("accounting")
  @@map("invoices")
}

/// Proyeksi anggaran per bulan untuk modul Forecast — berisi estimasi
/// pendapatan/beban per kategori per bulan.
model Forecast {
  id          String   @id @default(uuid()) @db.Uuid
  year        Int
  month       Int      // 1-12
  category    String   // revenue | expense | profit
  description String?
  amount      Decimal  // estimasi nominal
  currency    String   @default("IDR")
  createdBy   String   @map("created_by") @db.Uuid
  createdByUser User?  @relation("ForecastCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([year, month, category])
  @@index([year, month])
  @@schema("accounting")
  @@map("forecasts")
}

/// Batch upload CSV/Excel untuk modul Import — melacak setiap sesi import
/// beserta status, jumlah baris, dan error log.
model ImportBatch {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String
  status      String   @default("pending") // pending | processing | completed | failed
  totalRows   Int      @default(0)
  successRows Int      @default(0) @map("success_rows")
  errorRows   Int      @default(0) @map("error_rows")
  errorLog    String?  @map("error_log") // JSON array of { row, message }
  createdBy   String   @map("created_by") @db.Uuid
  createdByUser User?  @relation("ImportCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([createdBy])
  @@index([status])
  @@schema("accounting")
  @@map("import_batches")
}

/// Jadwal pengiriman laporan berkala untuk modul Schedules — user bisa
/// menjadwalkan laporan (GL, profitability, dll) untuk dikirim otomatis.
model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   // nama jadwal, misal "Laporan GL Bulanan"
  reportType  String   @map("report_type") // general-ledger | profitability | cash-flow | revenue | expenses
  frequency   String   // daily | weekly | monthly | quarterly
  dayOfMonth  Int?     @map("day_of_month") // 1-31 untuk monthly
  dayOfWeek   Int?     @map("day_of_week")  // 0-6 untuk weekly (0= Minggu)
  timeOfDay   String   @default("08:00") @map("time_of_day") // HH:MM
  recipients  String[] // array email penerima
  format      String   @default("pdf") // pdf | csv | xlsx
  enabled     Boolean  @default(true)
  lastSentAt  DateTime? @map("last_sent_at")
  createdBy   String   @map("created_by") @db.Uuid
  createdByUser User?  @relation("ScheduleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@schema("accounting")
  @@map("schedules")
}
