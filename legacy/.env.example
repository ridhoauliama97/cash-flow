# Cash Flow Dashboard — environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` (it is gitignored).

# --- Supabase (optional; app runs on local demo data without it) ---
# Get these at: Supabase Dashboard → Project Settings → API
# When set, the app switches from local demo data to the cloud database
# and enables authentication on the login screen.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Currency rates (currencyapi.com v3) ---
# Used for live exchange rates; leave blank to use static fallback rates.
# Can also be entered at runtime in Settings → Exchange Rates.
VITE_CURRENCY_API_KEY=
