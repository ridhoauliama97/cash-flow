// Prisma schema — Fase 1 MVP rebuild (lihat PRD.md §5.1)
// RBAC: users / divisions / roles / permissions / role_permissions / user_roles
// Auth ditangani Supabase (auth.users) — users adalah profil public yang
// mereferensikan auth.users(id). RLS diaktifkan via SQL di migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Profil user; id mengikuti auth.users (Supabase Auth).
model User {
  id         String     @id @db.Uuid
  email      String     @unique
  name       String?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  divisionId String?    @map("division_id") @db.Uuid
  division   Division?  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  roles      UserRole[]

  @@map("users")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  roles     Role[]
  costCenters CostCenter[]

  @@map("divisions")
}

/// Level role: staff/kepala/direktur/admin/superadmin (union di src/types/rbac.ts).
model Role {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique
  level      String
  divisionId String?  @map("division_id") @db.Uuid
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")
  users      UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

/// Action: create/read/update/delete/approve/print (union di src/types/rbac.ts).
model Permission {
  id     String @id @default(uuid()) @db.Uuid
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================================
// Master data (PRD §5.2)
// ============================================================================

/// Chart of accounts hierarkis. type: asset/liability/equity/revenue/expense
/// (union di src/types/master-data.ts). parent dihapus => ditolak jika punya child.
model ChartOfAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      String
  name      String
  type      String
  parentId  String?           @map("parent_id") @db.Uuid
  parent    ChartOfAccount?   @relation("CoaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  ChartOfAccount[]  @relation("CoaHierarchy")
  createdAt DateTime          @default(now()) @map("created_at")

  @@unique([code])
  @@index([parentId])
  @@map("chart_of_accounts")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("customers")
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  contactInfo String?  @map("contact_info")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("suppliers")
}

model CostCenter {
  id         String   @id @default(uuid()) @db.Uuid
  code       String
  name       String
  divisionId String?  @map("division_id") @db.Uuid
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([code])
  @@map("cost_centers")
}
